{
  "name": "mountly-react",
  "version": "2.0.1",
  "description": "React adapter for mountly widgets",
  "homepage": "https://github.com/jagreehal/mountly/tree/main/packages/adapters/mountly-react#readme",
  "bugs": {
    "url": "https://github.com/jagreehal/mountly/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/mountly",
    "directory": "packages/adapters/mountly-react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --declarationMap false --outDir dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepack": "rm -f LICENSE && cp ../../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE && ln -s ../../../LICENSE LICENSE"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "mountly": "^0.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "mountly": "^0.3.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
