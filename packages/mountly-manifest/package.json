{
  "name": "mountly-manifest",
  "version": "1.0.3",
  "description": "Vertical registry schema and host helpers for mountly micro-frontends",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/mountly",
    "directory": "packages/mountly-manifest"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./schema.json": "./schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --declarationMap false --outDir dist && node scripts/gen-schema.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepack": "rm -f LICENSE && cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE && ln -s ../../LICENSE LICENSE"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mountly": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "mountly": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "mountly": {
      "optional": true
    }
  }
}
