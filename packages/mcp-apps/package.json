{
  "name": "mountly-mcp",
  "version": "3.0.0",
  "description": "Build MCP Apps (SEP-1865) views from your React, Vue or Svelte components — one build emits the ui:// resource, its sidecar, and the MCP server wiring.",
  "keywords": [
    "chatgpt",
    "claude",
    "mcp",
    "mcp-apps",
    "mcp-ui",
    "model-context-protocol",
    "react",
    "sep-1865",
    "svelte",
    "vite-plugin",
    "vue",
    "widget"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jagreehal/mountly",
    "directory": "packages/mcp-apps"
  },
  "bin": {
    "mountly-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./artifact": {
      "types": "./dist/artifact/index.d.ts",
      "import": "./dist/artifact/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./bridge/iframe-entry.js": "./dist/bridge/iframe-entry.js",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./json-render": {
      "types": "./dist/json-render/index.d.ts",
      "import": "./dist/json-render/index.js"
    },
    "./json-render/server": {
      "types": "./dist/json-render/server.d.ts",
      "import": "./dist/json-render/server.js"
    },
    "./json-render/app": {
      "types": "./dist/json-render/app.d.ts",
      "import": "./dist/json-render/app.js"
    },
    "./json-render/mcp": {
      "types": "./dist/json-render/mcp.d.ts",
      "import": "./dist/json-render/mcp.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js"
    },
    "./dev/host-entry.js": "./dist/dev/host-entry.js",
    "./dev/sandbox-entry.js": "./dist/dev/sandbox-entry.js",
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --declarationMap false --outDir dist",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@json-render/core": "0.20.0",
    "@json-render/react": "0.20.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ai": "6.0.208",
    "axe-core": "4.13.0",
    "jsdom": "^30.0.1",
    "mountly": "^0.3.1",
    "mountly-react": "workspace:^",
    "mountly-svelte": "workspace:^",
    "mountly-vue": "workspace:^",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "peerDependencies": {
    "@json-render/core": "^0.20.0",
    "@json-render/react": "^0.20.0",
    "ai": "^7.0.65",
    "axe-core": ">=4.10.0",
    "mountly": "^0.3.1",
    "mountly-react": "^2.0.1",
    "mountly-svelte": "^2.0.1",
    "mountly-vue": "^2.0.1",
    "playwright": ">=1.62.1",
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8.2.1"
  },
  "peerDependenciesMeta": {
    "@json-render/core": {
      "optional": true
    },
    "@json-render/react": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "mountly-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "mountly-vue": {
      "optional": true
    },
    "mountly-svelte": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "axe-core": {
      "optional": true
    }
  }
}
