<script setup lang="ts">
import { computed, ref, watch } from "vue";
import { useMcpApp, useToolResult } from "mountly-mcp/vue";

interface DashboardCard {
  label: string;
  value: string | number;
}

interface DashboardData {
  topic?: string;
  refreshedAt?: string;
  cards?: DashboardCard[];
}

interface DashboardResult {
  structuredContent?: DashboardData;
}

const mcp = useMcpApp();
const result = useToolResult<DashboardResult>();
const data = ref<DashboardData | undefined>();
const busy = ref(false);
const status = ref("Connected.");

watch(
  result,
  (value) => {
    if (value?.structuredContent) data.value = value.structuredContent;
  },
  { immediate: true },
);

const cards = computed(() => data.value?.cards ?? []);
const title = computed(() =>
  data.value?.topic ? `${data.value.topic} Dashboard` : "Dashboard",
);

async function refresh() {
  busy.value = true;
  status.value = "Refreshing…";
  try {
    const next = (await mcp.callServerTool({
      name: "refreshDashboard",
      arguments: { reason: "User clicked refresh" },
    })) as DashboardResult;
    const content = next.structuredContent;
    if (content) {
      data.value = {
        ...data.value,
        ...content,
        topic: content.topic ?? data.value?.topic,
      };
    }
    status.value = content?.refreshedAt
      ? `Refreshed ${new Date(content.refreshedAt).toLocaleTimeString()}`
      : "Refreshed.";
  } catch (error) {
    status.value = error instanceof Error ? error.message : "Refresh failed.";
  } finally {
    busy.value = false;
  }
}
</script>

<template>
  <div class="card">
    <p class="eyebrow">MCP App · Mountly</p>
    <h1>{{ title }}</h1>
    <p class="subtitle">
      Built with <code>mountly-mcp</code>. Try Refresh to call an app-only tool.
    </p>
    <div class="grid">
      <div v-if="cards.length === 0" v-for="i in 3" :key="i" class="metric">
        <div class="label">—</div>
        <div class="value">—</div>
      </div>
      <div v-for="c in cards" :key="c.label" class="metric">
        <div class="label">{{ c.label }}</div>
        <div class="value">{{ c.value }}</div>
      </div>
    </div>
    <div class="row">
      <button type="button" :disabled="busy" @click="refresh">Refresh data</button>
      <span class="status">{{ status }}</span>
    </div>
  </div>
</template>

