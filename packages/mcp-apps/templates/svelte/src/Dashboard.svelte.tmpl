<script lang="ts">
  import type { McpViewProps } from "mountly-mcp";

  interface DashboardCard {
    label: string;
    value: string | number;
  }

  interface DashboardData {
    topic?: string;
    refreshedAt?: string;
    cards?: DashboardCard[];
  }

  interface DashboardResult {
    structuredContent?: DashboardData;
  }

  let { mcp, toolResult }: McpViewProps = $props();

  let data = $state<DashboardData | undefined>();
  let busy = $state(false);
  let status = $state("Connected.");

  $effect(() => {
    const next = (toolResult as DashboardResult | undefined)?.structuredContent;
    if (next) data = next;
  });

  const cards = $derived(data?.cards ?? []);
  const title = $derived(data?.topic ? `${data.topic} Dashboard` : "Dashboard");

  async function refresh() {
    busy = true;
    status = "Refreshing…";
    try {
      const next = (await mcp.callServerTool({
        name: "refreshDashboard",
        arguments: { reason: "User clicked refresh" },
      })) as DashboardResult;
      const content = next.structuredContent;
      if (content) {
        data = {
          ...data,
          ...content,
          topic: content.topic ?? data?.topic,
        };
      }
      status = content?.refreshedAt
        ? `Refreshed ${new Date(content.refreshedAt).toLocaleTimeString()}`
        : "Refreshed.";
    } catch (error) {
      status = error instanceof Error ? error.message : "Refresh failed.";
    } finally {
      busy = false;
    }
  }
</script>

<div class="card">
  <p class="eyebrow">MCP App · Mountly</p>
  <h1>{title}</h1>
  <p class="subtitle">
    Built with <code>mountly-mcp</code> — try Refresh to call an app-only tool.
  </p>
  <div class="grid">
    {#if cards.length === 0}
      {#each [1, 2, 3] as i (i)}
        <div class="metric">
          <div class="label">—</div>
          <div class="value">—</div>
        </div>
      {/each}
    {:else}
      {#each cards as c (c.label)}
        <div class="metric">
          <div class="label">{c.label}</div>
          <div class="value">{c.value}</div>
        </div>
      {/each}
    {/if}
  </div>
  <div class="row">
    <button type="button" disabled={busy} onclick={refresh}>Refresh data</button>
    <span class="status">{status}</span>
  </div>
</div>

