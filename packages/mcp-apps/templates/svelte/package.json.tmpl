{
  "name": "{{name}}",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "mountly-mcp dev --server ./server.mjs",
    "verify": "mountly-mcp verify",
    "verify:strict": "mountly-mcp verify --strict",
    "verify:render": "mountly-mcp verify --strict --render",
    "doctor": "mountly-mcp doctor",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mountly-mcp": "^{{mcpVersion}}",
    "mountly-svelte": "^2.0.3",
    "svelte": "^5.56.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
